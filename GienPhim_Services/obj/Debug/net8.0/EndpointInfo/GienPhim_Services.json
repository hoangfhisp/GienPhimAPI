    "/api/User/UpdateInfoUser": {
      "put": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "UserName"
                ],
                "type": "object",
                "properties": {
                  "UserName": {
                    "pattern": "^[a-zA-Z0-9]+$",
                    "type": "string"
                  },
                  "NameND": {
                    "maxLength": 255,
                    "minLength": 0,
                    "type": "string"
                  },
                  "GioiTinh": {
                    "maximum": 2,
                    "minimum": 0,
                    "type": "integer",
                    "format": "int32"
                  },
                  "MoTa": {
                    "maxLength": 500,
                    "type": "string"
                  },
                  "AvatarND": {
                    "type": "string",
                    "format": "binary"
                  },
                  "PhoneNumber": {
                    "pattern": "^(?:\\+84|0)\\d{9}$",
                    "type": "string",
                    "format": "tel"
                  }
                }
              },
              "encoding": {
                "UserName": {
                  "style": "form"
                },
                "NameND": {
                  "style": "form"
                },
                "GioiTinh": {
                  "style": "form"
                },
                "MoTa": {
                  "style": "form"
                },
                "AvatarND": {
                  "style": "form"
                },
                "PhoneNumber": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
