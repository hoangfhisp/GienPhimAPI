# ==============================================================================
# GienPhim API - Environment Configuration Template
# ==============================================================================

# ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000;https://+:5001

# Microsoft SQL Server Database Connection Strings
ConnectionStrings__AuthDb=Server=localhost,1433;Database=GienPhim_Auth;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__UserDb=Server=localhost,1433;Database=GienPhim_User;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__FilmDb=Server=localhost,1433;Database=GienPhim_Film;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__InteractionDb=Server=localhost,1433;Database=GienPhim_Interaction;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__MembershipDb=Server=localhost,1433;Database=GienPhim_Membership;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__PaymentDb=Server=localhost,1433;Database=GienPhim_Payment;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__WalletDb=Server=localhost,1433;Database=GienPhim_Wallet;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
ConnectionStrings__OrderDb=Server=localhost,1433;Database=GienPhim_Order;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;

# JSON Web Token (JWT) Security Configuration
AuthOptions__Jwt__SecretKey=your_super_secret_jwt_key_with_sufficient_entropy_at_least_32_characters_long
AuthOptions__Jwt__Issuer=GienPhimIdentity
AuthOptions__Jwt__Audience=GienPhimClient
AuthOptions__Jwt__ExpireMinutes=30
AuthOptions__RefreshTokenExpireDays=15

# SMTP Email Dispatcher Settings
EmailSettings__Name=GienPhim Notification
EmailSettings__Email=noreply@gienphim.vn
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__SSL=true
EmailSettings__Pass=your_smtp_app_password

# Internal & External Service Endpoints
ServiceUrls__UserService=https://localhost:5001
ServiceUrls__FilmService=https://localhost:5001
ServiceUrls__PhimApi=https://phimapi.com/
ServiceUrls__WalletService=https://localhost:5001

# VNPay Payment Gateway Integration
Vnpay__Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Vnpay__Api=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
Vnpay__TmnCode=YOUR_TMN_CODE
Vnpay__HashSecret=YOUR_VNPAY_HASH_SECRET
Vnpay__Returnurl=https://localhost:5001/api/Wallet/CallbackVnPay

# Frontend Application Integration
Frontend__PaymentResultUrl=http://localhost:3000/payment-result
AllowedOrigins=http://localhost:3000
